---
import type { Content, ProjectKind } from '../data/types';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';

interface Props {
  t: Content;
}
const { t } = Astro.props;
const p = t.projects;
const featured = p.items.filter((i) => i.featured);
const others = p.items.filter((i) => !i.featured);
const kinds = Object.keys(p.kinds) as ProjectKind[];
const linkLabel = (kind: ProjectKind) => (kind === 'research' ? t.ui.readPaper : t.ui.visit);
---

<section id="projects" class="section">
  <div class="container">
    <SectionHead num="03" title={p.title} />
    <p class="intro">{p.intro}</p>

    {
      featured.map((proj) => (
        <article class="featured card reveal" data-kind={proj.kind}>
          <div class="f-main">
            <span class={`badge ${proj.kind}`}>{p.kinds[proj.kind]}</span>
            <h3>{proj.title}</h3>
            <p class="context mono">{proj.context}</p>
            <p class="summary">{proj.summary}</p>
            <ul class="chips">
              {proj.stack.map((s) => (
                <li class="chip">{s}</li>
              ))}
            </ul>
            {proj.url && (
              <a href={proj.url} class="btn btn-primary" target="_blank" rel="noopener">
                {linkLabel(proj.kind)} <Icon name="external" />
              </a>
            )}
          </div>
          <dl class="psr">
            <div>
              <dt class="mono">{p.labels.problem}</dt>
              <dd>{proj.problem}</dd>
            </div>
            <div>
              <dt class="mono">{p.labels.solution}</dt>
              <dd>{proj.solution}</dd>
            </div>
            <div>
              <dt class="mono">{p.labels.result}</dt>
              <dd>{proj.result}</dd>
            </div>
          </dl>
        </article>
      ))
    }

    <div class="filters" role="group" aria-label={p.title}>
      <button type="button" class="filter mono active" data-filter="all" aria-pressed="true">{t.ui.all}</button>
      {
        kinds.map((k) => (
          <button type="button" class="filter mono" data-filter={k} aria-pressed="false">
            {p.kinds[k]}
          </button>
        ))
      }
    </div>

    <div class="grid">
      {
        others.map((proj) => (
          <article class="project card reveal" data-kind={proj.kind}>
            <div class="top">
              <span class={`badge ${proj.kind}`}>{p.kinds[proj.kind]}</span>
              <span class="context mono">{proj.context}</span>
            </div>
            <h3>{proj.title}</h3>
            <p class="summary">{proj.summary}</p>
            <dl class="psr compact">
              <div>
                <dt class="mono">{p.labels.problem}</dt>
                <dd>{proj.problem}</dd>
              </div>
              <div>
                <dt class="mono">{p.labels.solution}</dt>
                <dd>{proj.solution}</dd>
              </div>
              <div>
                <dt class="mono">{p.labels.result}</dt>
                <dd>{proj.result}</dd>
              </div>
            </dl>
            <ul class="chips">
              {proj.stack.map((s) => (
                <li class="chip">{s}</li>
              ))}
            </ul>
            {proj.url && (
              <a href={proj.url} class="link mono" target="_blank" rel="noopener">
                {linkLabel(proj.kind)} <Icon name="external" class="icon small" />
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const cards = document.querySelectorAll<HTMLElement>('.project');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => {
        const on = b === btn;
        b.classList.toggle('active', on);
        b.setAttribute('aria-pressed', String(on));
      });
      cards.forEach((c) => {
        c.hidden = f !== 'all' && c.dataset.kind !== f;
      });
    }),
  );
</script>

<style>
  .intro {
    color: var(--muted);
    max-width: 70ch;
    margin: -12px 0 28px;
  }
  .badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 4px 8px;
    border-radius: 6px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .badge.public {
    background: color-mix(in srgb, var(--ok) 14%, transparent);
    color: var(--ok);
  }
  .badge.research {
    background: color-mix(in srgb, var(--code-key) 14%, transparent);
    color: var(--code-key);
  }
  .context {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .summary {
    color: var(--text);
  }

  .featured {
    display: grid;
    gap: 28px;
    padding: 28px;
    margin-bottom: 36px;
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
  }
  @media (min-width: 900px) {
    .featured {
      grid-template-columns: 1fr 1.1fr;
      padding: 36px;
      gap: 40px;
    }
  }
  .f-main {
    display: grid;
    gap: 12px;
    align-content: start;
    justify-items: start;
  }
  .featured h3 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
  }
  .featured .chips {
    margin: 6px 0 8px;
  }

  .psr {
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .psr dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 2px;
  }
  .psr dd {
    margin: 0;
    color: var(--muted);
  }
  .psr.compact {
    gap: 10px;
    font-size: 0.92rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }
  .filter {
    font-size: 0.8rem;
    padding: 7px 12px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
  }
  .filter:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .filter.active {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent);
  }

  .grid {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1080px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .project {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px;
    transition: border-color 0.15s, transform 0.15s;
  }
  .project:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
  }
  .project[hidden] {
    display: none;
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    justify-content: space-between;
  }
  .project h3 {
    font-size: 1.1rem;
    font-weight: 700;
  }
  .project .chips {
    margin-top: auto;
    padding-top: 6px;
  }
  .link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
  }
  .link :global(.small) {
    width: 14px;
    height: 14px;
  }
</style>
