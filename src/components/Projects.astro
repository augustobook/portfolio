---
import type { Content, ProjectKind } from '../data/types';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { withBase } from '../lib/utils';

interface Props {
  t: Content;
}
const { t } = Astro.props;
const p = t.projects;
const featured = p.items.filter((i) => i.featured);
const others = p.items.filter((i) => !i.featured);
const linkLabel = (kind: ProjectKind) => (kind === 'research' ? t.ui.readPaper : t.ui.visit);
---

<section id="projects" class="section">
  <div class="container">
    <SectionHead num="03" title={p.title} />

    {featured.length > 0 && <h3 class="group-title">{p.featuredTitle}</h3>}
    {
      featured.map((proj) => (
        <article class="featured split card reveal" data-kind={proj.kind}>
          <div class="f-main">
            <span class={`badge ${proj.kind}`}>{p.kinds[proj.kind]}</span>
            <h3>{proj.title}</h3>
            <p class="context mono">{proj.context}</p>
            <p class="summary">{proj.summary}</p>
            <ul class="chips">
              {proj.stack.map((s) => (
                <li class="chip">{s}</li>
              ))}
            </ul>
            {proj.url && (
              <a href={proj.url} class="btn btn-primary" target="_blank" rel="noopener">
                {linkLabel(proj.kind)} <Icon name="external" />
              </a>
            )}
          </div>
          <dl class="psr">
            <div>
              <dt class="mono">{p.labels.problem}</dt>
              <dd>{proj.problem}</dd>
            </div>
            <div>
              <dt class="mono">{p.labels.solution}</dt>
              <dd>{proj.solution}</dd>
            </div>
            <div>
              <dt class="mono">{p.labels.result}</dt>
              <dd>{proj.result}</dd>
            </div>
          </dl>
          {proj.images && (
            <div class="slider" data-slider>
              <ul class="track" tabindex="0" aria-label={proj.title}>
                {proj.images.map((img) => (
                  <li>
                    <a href={withBase(img.src)} target="_blank" rel="noopener">
                      <img src={withBase(img.src)} alt={img.alt} width="1440" height="900" loading="lazy" decoding="async" />
                    </a>
                    <p class="caption">{img.alt}</p>
                  </li>
                ))}
              </ul>
              {proj.images.length > 1 && (
                <div class="controls">
                  <button type="button" class="nav" data-prev aria-label={t.ui.prevImage} title={t.ui.prevImage}>
                    <Icon name="prev" />
                  </button>
                  <div class="dots">
                    {proj.images.map((_, i) => (
                      <button type="button" class="dot" data-dot={i} aria-label={t.ui.goToImage.replace('{n}', String(i + 1))} />
                    ))}
                  </div>
                  <span class="count mono" data-count>
                    1 / {proj.images.length}
                  </span>
                  <button type="button" class="nav" data-next aria-label={t.ui.nextImage} title={t.ui.nextImage}>
                    <Icon name="next" />
                  </button>
                </div>
              )}
            </div>
          )}
        </article>
      ))
    }

    <h3 class="group-title">{p.industryTitle}</h3>
    <p class="note">{p.industryNote}</p>

    <div class="list">
      {
        others.map((proj) => (
          <article class="project split card reveal" data-kind={proj.kind}>
            <div class="f-main">
              <p class="company mono">{proj.context}</p>
              <h3>{proj.title}</h3>
              <p class="summary">{proj.summary}</p>
              <dl class="psr">
                <div>
                  <dt class="mono">{p.labels.problem}</dt>
                  <dd>{proj.problem}</dd>
                </div>
                <div>
                  <dt class="mono">{p.labels.result}</dt>
                  <dd set:html={proj.result} />
                </div>
              </dl>
              <ul class="chips">
                {proj.stack.map((s) => (
                  <li class="chip">{s}</li>
                ))}
              </ul>
            </div>
            {proj.highlights && (
              <div class="built">
                <p class="built-title mono">{p.labels.built}</p>
                <ul>
                  {proj.highlights.map((h) => (
                    <li set:html={h} />
                  ))}
                </ul>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const smooth = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((slider) => {
    const track = slider.querySelector<HTMLElement>('.track')!;
    const first = track.firstElementChild as HTMLElement;
    const slides = track.children.length;
    const controls = slider.querySelector<HTMLElement>('.controls');
    const prev = slider.querySelector<HTMLButtonElement>('[data-prev]');
    const next = slider.querySelector<HTMLButtonElement>('[data-next]');
    const count = slider.querySelector<HTMLElement>('[data-count]');
    const dots = slider.querySelectorAll<HTMLButtonElement>('[data-dot]');
    if (!controls || !prev || !next) return;

    // Anda uma captura por vez; o último índice deixa as últimas capturas visíveis juntas.
    const step = () => first.offsetWidth + parseFloat(getComputedStyle(track).columnGap || '0');
    const perView = () => Math.max(1, Math.round((track.clientWidth + step() - first.offsetWidth) / step()));
    const last = () => Math.max(0, slides - perView());
    const current = () => Math.min(last(), Math.round(track.scrollLeft / step()));
    const goTo = (i: number) => {
      const target = Math.max(0, Math.min(last(), i));
      track.scrollTo({ left: target * step(), behavior: smooth });
    };
    const update = () => {
      const i = current();
      const shown = perView();
      controls.hidden = last() === 0;
      prev.disabled = i === 0;
      next.disabled = i === last();
      if (count) {
        const end = Math.min(slides, i + shown);
        count.textContent = shown > 1 ? `${i + 1}–${end} / ${slides}` : `${i + 1} / ${slides}`;
      }
      dots.forEach((d, j) => {
        d.hidden = j > last();
        d.setAttribute('aria-current', String(j === i));
      });
    };

    prev.addEventListener('click', () => goTo(current() - 1));
    next.addEventListener('click', () => goTo(current() + 1));
    dots.forEach((d) => d.addEventListener('click', () => goTo(Number(d.dataset.dot))));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
        e.preventDefault();
        goTo(current() + (e.key === 'ArrowRight' ? 1 : -1));
      }
    });
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

<style>
  .group-title {
    font-size: 1.3rem;
    font-weight: 700;
    margin: 0 0 18px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .group-title::before {
    content: '';
    width: 4px;
    height: 1.1em;
    border-radius: 2px;
    background: var(--accent);
  }
  .note {
    color: var(--muted);
    max-width: 70ch;
    margin: -8px 0 22px;
  }
  .badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 4px 8px;
    border-radius: 6px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .badge.public {
    background: color-mix(in srgb, var(--ok) 14%, transparent);
    color: var(--ok);
  }
  .badge.research {
    background: color-mix(in srgb, var(--code-key) 14%, transparent);
    color: var(--code-key);
  }
  .context {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .summary {
    color: var(--text);
  }

  /* Card em duas colunas, usado no destaque e nos projetos profissionais. */
  .split {
    display: grid;
    gap: 28px;
    padding: 28px;
  }
  @media (min-width: 900px) {
    .split {
      grid-template-columns: 1fr 1.1fr;
      padding: 36px;
      gap: 40px;
    }
  }
  .featured {
    margin-bottom: 56px;
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
  }
  .f-main {
    display: grid;
    gap: 12px;
    align-content: start;
    justify-items: start;
  }
  .featured h3 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
  }
  .featured .chips {
    margin: 6px 0 8px;
  }

  /* Slider de capturas: ocupa a largura toda do card, até 3 capturas visíveis por vez. */
  .slider {
    --per-view: 1;
    --gap: 14px;
    grid-column: 1 / -1;
    min-width: 0;
    display: grid;
    gap: 12px;
  }
  @media (min-width: 640px) {
    .slider {
      --per-view: 2;
    }
  }
  @media (min-width: 900px) {
    .slider {
      --per-view: 3;
    }
  }
  .track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: 10px;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .track li {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
    scroll-snap-align: start;
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .track a {
    display: block;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    transition: border-color 0.15s;
  }
  .track a:hover {
    border-color: var(--accent);
  }
  .track img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
  }
  .caption {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .controls[hidden] {
    display: none;
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .nav {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, opacity 0.15s;
  }
  .nav:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .nav:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .dots {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    flex: 1;
    justify-content: center;
  }
  .dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: var(--border);
    cursor: pointer;
    transition: width 0.2s, background 0.2s;
  }
  .dot[aria-current='true'] {
    width: 22px;
    background: var(--accent);
  }
  .count {
    font-size: 0.78rem;
    color: var(--muted);
    min-width: 3.5em;
    text-align: right;
  }

  .psr {
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .psr dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 2px;
  }
  .psr dd {
    margin: 0;
    color: var(--muted);
  }

  .list {
    display: grid;
    gap: 20px;
  }
  .project {
    transition: border-color 0.15s;
  }
  .project:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
  }
  .company {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--accent);
  }
  .project h3 {
    font-size: clamp(1.25rem, 2.4vw, 1.5rem);
    font-weight: 800;
  }
  .project .psr {
    margin: 4px 0 6px;
  }

  .built {
    padding: 22px 24px;
    border-radius: 12px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    align-self: start;
  }
  .built-title {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .built ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .built li {
    position: relative;
    padding-left: 20px;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .built li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
</style>
