---
import type { Content, ProjectKind } from '../data/types';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { withBase } from '../lib/utils';

interface Props {
  t: Content;
}
const { t } = Astro.props;
const p = t.projects;
const featured = p.items.filter((i) => i.featured);
const others = p.items.filter((i) => !i.featured);
const linkLabel = (kind: ProjectKind) => (kind === 'research' ? t.ui.readPaper : t.ui.visit);
---

<section id="projects" class="section">
  <div class="container">
    <SectionHead num="03" title={p.title} />

    {featured.length > 0 && <h3 class="group-title">{p.featuredTitle}</h3>}
    {
      featured.map((proj) => (
        <article class="featured split card reveal" data-kind={proj.kind}>
          <div class="f-main">
            <span class={`badge ${proj.kind}`}>{p.kinds[proj.kind]}</span>
            <h3>{proj.title}</h3>
            <p class="context mono">{proj.context}</p>
            <p class="summary">{proj.summary}</p>
            <ul class="chips">
              {proj.stack.map((s) => (
                <li class="chip">{s}</li>
              ))}
            </ul>
            {proj.url && (
              <a href={proj.url} class="btn btn-primary" target="_blank" rel="noopener">
                {linkLabel(proj.kind)} <Icon name="external" />
              </a>
            )}
          </div>
          <dl class="psr">
            <div>
              <dt class="mono">{p.labels.problem}</dt>
              <dd>{proj.problem}</dd>
            </div>
            <div>
              <dt class="mono">{p.labels.solution}</dt>
              <dd>{proj.solution}</dd>
            </div>
            <div>
              <dt class="mono">{p.labels.result}</dt>
              <dd>{proj.result}</dd>
            </div>
          </dl>
          {proj.images && (
            <ul class="gallery">
              {proj.images.map((img) => (
                <li>
                  <a href={withBase(img.src)} target="_blank" rel="noopener">
                    <img src={withBase(img.src)} alt={img.alt} width="1440" height="900" loading="lazy" decoding="async" />
                  </a>
                </li>
              ))}
            </ul>
          )}
        </article>
      ))
    }

    <h3 class="group-title">{p.industryTitle}</h3>
    <p class="note">{p.industryNote}</p>

    <div class="list">
      {
        others.map((proj) => (
          <article class="project split card reveal" data-kind={proj.kind}>
            <div class="f-main">
              <p class="company mono">{proj.context}</p>
              <h3>{proj.title}</h3>
              <p class="summary">{proj.summary}</p>
              <dl class="psr">
                <div>
                  <dt class="mono">{p.labels.problem}</dt>
                  <dd>{proj.problem}</dd>
                </div>
                <div>
                  <dt class="mono">{p.labels.result}</dt>
                  <dd set:html={proj.result} />
                </div>
              </dl>
              <ul class="chips">
                {proj.stack.map((s) => (
                  <li class="chip">{s}</li>
                ))}
              </ul>
            </div>
            {proj.highlights && (
              <div class="built">
                <p class="built-title mono">{p.labels.built}</p>
                <ul>
                  {proj.highlights.map((h) => (
                    <li set:html={h} />
                  ))}
                </ul>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .group-title {
    font-size: 1.3rem;
    font-weight: 700;
    margin: 0 0 18px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .group-title::before {
    content: '';
    width: 4px;
    height: 1.1em;
    border-radius: 2px;
    background: var(--accent);
  }
  .note {
    color: var(--muted);
    max-width: 70ch;
    margin: -8px 0 22px;
  }
  .badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 4px 8px;
    border-radius: 6px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .badge.public {
    background: color-mix(in srgb, var(--ok) 14%, transparent);
    color: var(--ok);
  }
  .badge.research {
    background: color-mix(in srgb, var(--code-key) 14%, transparent);
    color: var(--code-key);
  }
  .context {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .summary {
    color: var(--text);
  }

  /* Card em duas colunas, usado no destaque e nos projetos profissionais. */
  .split {
    display: grid;
    gap: 28px;
    padding: 28px;
  }
  @media (min-width: 900px) {
    .split {
      grid-template-columns: 1fr 1.1fr;
      padding: 36px;
      gap: 40px;
    }
  }
  .featured {
    margin-bottom: 56px;
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
  }
  .f-main {
    display: grid;
    gap: 12px;
    align-content: start;
    justify-items: start;
  }
  .featured h3 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
  }
  .featured .chips {
    margin: 6px 0 8px;
  }

  /* Galeria de capturas: ocupa a largura toda do card. */
  .gallery {
    grid-column: 1 / -1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  @media (min-width: 640px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .gallery a {
    display: block;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    transition: transform 0.15s, border-color 0.15s;
  }
  .gallery a:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }
  .gallery img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
  }

  .psr {
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .psr dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 2px;
  }
  .psr dd {
    margin: 0;
    color: var(--muted);
  }

  .list {
    display: grid;
    gap: 20px;
  }
  .project {
    transition: border-color 0.15s;
  }
  .project:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
  }
  .company {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--accent);
  }
  .project h3 {
    font-size: clamp(1.25rem, 2.4vw, 1.5rem);
    font-weight: 800;
  }
  .project .psr {
    margin: 4px 0 6px;
  }

  .built {
    padding: 22px 24px;
    border-radius: 12px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    align-self: start;
  }
  .built-title {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .built ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .built li {
    position: relative;
    padding-left: 20px;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .built li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
</style>
