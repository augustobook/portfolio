---
import type { Content, Lang } from '../data/types';
import { profile } from '../data/profile';
import { monthsBetween, publicFileExists, withBase } from '../lib/utils';
import Icon from './Icon.astro';

interface Props {
  t: Content;
  lang: Lang;
}
const { t, lang } = Astro.props;
const hasCutout = publicFileExists(profile.photoCutout);
const hasPhoto = publicFileExists(profile.photo);
const cvFile = profile.cvPdf[lang];
const hasCv = publicFileExists(cvFile);
const years = Math.floor(monthsBetween(profile.careerStart) / 12);
const stats = t.about.stats.map((s) => ({ ...s, value: s.value.replace('{years}', String(years)) }));
---

<section id="top" class="hero">
  <div class="band">
    <span class="dots" aria-hidden="true"></span>
    <div class="container grid">
      <div class="intro">
        <p class="kicker">{t.hero.kicker}</p>
        <h1>{profile.name}</h1>
        <p class="role">{t.hero.role}</p>
        <p class="meta">
          <span><Icon name="pin" class="icon small" /> {t.hero.location}</span>
          <span class="open"><span class="led"></span> {t.hero.status}</span>
        </p>
        <p class="tagline">{t.hero.tagline}</p>
        <div class="hero-actions">
          <a href="#projects" class="btn btn-primary">{t.ui.seeProjects} <Icon name="arrow" /></a>
          {hasCv && <a href={withBase(cvFile)} class="btn btn-ghost" download><Icon name="download" /> {t.ui.downloadCv}</a>}
          <div class="socials">
            <a href={profile.linkedin} class="social" aria-label="LinkedIn" target="_blank" rel="noopener"><Icon name="linkedin" /></a>
            {profile.github && <a href={profile.github} class="social" aria-label="GitHub" target="_blank" rel="noopener"><Icon name="github" /></a>}
            <a href={`mailto:${profile.email}`} class="social" aria-label="E-mail"><Icon name="mail" /></a>
          </div>
        </div>
      </div>

      <div class="visual">
        <span class="sun" aria-hidden="true"></span>
        <span class="blob" aria-hidden="true"></span>
        <svg class="doodle" viewBox="0 0 80 60" aria-hidden="true">
          <path d="M6 40c10-22 22-28 30-18s-6 24 6 22 18-26 32-30" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
        </svg>
        {
          hasCutout ? (
            <img class="person" src={withBase(profile.photoCutout)} alt={profile.name} width="720" height="720" fetchpriority="high" />
          ) : hasPhoto ? (
            <img class="person round" src={withBase(profile.photo)} alt={profile.name} width="1079" height="1080" fetchpriority="high" />
          ) : (
            <span class="person round initials">{profile.initials}</span>
          )
        }
        <div class="badge bottom">
          <span class="b-icon mono">AI</span>
          <span class="b-text">
            <strong>{t.hero.badge.title}</strong>
            <span class="b-label">{t.hero.badge.detail}</span>
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="container">
    <ul class="stats">
      {
        stats.map((s) => (
          <li>
            <span class="value mono">{s.value}</span>
            <span class="label">{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Faixa colorida de ponta a ponta, com a foto sem fundo apoiada na base. */
  .band {
    position: relative;
    overflow: hidden;
    color: #fff;
    background:
      radial-gradient(1200px 500px at 85% 20%, rgba(255, 255, 255, 0.12), transparent 60%),
      linear-gradient(135deg, var(--hero-from), var(--hero-to));
  }
  .dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.14) 1px, transparent 1.5px);
    background-size: 22px 22px;
    mask-image: linear-gradient(90deg, transparent, #000 30%, #000 70%, transparent);
    pointer-events: none;
  }
  .grid {
    position: relative;
    display: grid;
    gap: 24px;
    align-items: end;
    padding-top: 56px;
  }
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 32px;
      padding-top: 40px;
    }
  }
  .intro {
    align-self: center;
    padding-bottom: 24px;
  }
  @media (min-width: 960px) {
    .intro {
      padding-bottom: 96px;
    }
  }
  .kicker {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 6px;
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.04;
    color: #fff;
  }
  .role {
    margin-top: 14px;
    font-size: clamp(1.15rem, 2.4vw, 1.45rem);
    font-weight: 700;
    color: var(--warm);
  }
  .meta {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.85);
  }
  .meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .meta :global(.small) {
    width: 15px;
    height: 15px;
  }
  .open {
    color: #7dffb2;
  }
  .led {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3ddc84;
    box-shadow: 0 0 0 3px rgba(61, 220, 132, 0.3);
  }
  .tagline {
    margin-top: 18px;
    max-width: 54ch;
    color: rgba(255, 255, 255, 0.88);
    font-size: 1.08rem;
  }
  .hero-actions {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .hero-actions .btn {
    border-radius: 999px;
    padding: 12px 22px;
  }
  .hero-actions .btn.btn-primary,
  .hero-actions .btn.btn-primary:hover {
    background: var(--warm);
    border-color: var(--warm);
    color: #1d1300;
  }
  .hero-actions .btn.btn-primary:hover {
    filter: brightness(1.06);
  }
  .btn-ghost {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.55);
    color: #fff;
  }
  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: #fff;
    color: #fff;
  }
  .socials {
    display: flex;
    gap: 8px;
  }
  .social {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.45);
    transition: background 0.15s, transform 0.15s;
  }
  .social:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-1px);
  }
  .social :global(.icon) {
    width: 19px;
    height: 19px;
  }

  .visual {
    position: relative;
    justify-self: center;
    width: min(440px, 92vw);
    aspect-ratio: 1;
  }
  .sun {
    position: absolute;
    left: 12%;
    right: 6%;
    bottom: 4%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--warm);
  }
  .blob {
    position: absolute;
    left: 0;
    top: 30%;
    width: 22%;
    aspect-ratio: 1.2;
    border-radius: 48% 52% 60% 40% / 55% 45% 55% 45%;
    background: var(--warm);
    opacity: 0.9;
  }
  .doodle {
    position: absolute;
    left: 4%;
    top: 8%;
    width: 18%;
    color: rgba(255, 255, 255, 0.85);
  }
  .person {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom;
    filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.25));
  }
  .person.round {
    inset: auto 12% 8% 12%;
    width: 76%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    border: 6px solid rgba(255, 255, 255, 0.85);
  }
  .initials {
    display: grid;
    place-items: center;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 4rem;
  }
  .badge {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 230px;
    padding: 10px 14px;
    border-radius: 14px;
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);
  }
  /* Selo sobre o ombro, fora do rosto. */
  .badge.bottom {
    right: -10%;
    bottom: 15%;
    max-width: 200px;
  }
  .b-text {
    display: grid;
    line-height: 1.3;
  }
  .b-text strong {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text);
  }
  .b-label {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .b-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
  }
  @media (max-width: 520px) {
    .badge {
      max-width: 190px;
      padding: 8px 10px;
    }
    /* No celular não há espaço ao lado do rosto para o selo. */
    .badge.bottom {
      display: none;
    }
  }

  /* Faixa de números sobreposta à base da faixa colorida. */
  .stats {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: -48px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow), 0 20px 40px -20px rgba(10, 60, 130, 0.35);
  }
  @media (min-width: 720px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stats li {
    padding: 20px 22px;
    display: grid;
    gap: 4px;
    align-content: start;
  }
  .stats li + li {
    border-left: 1px solid var(--border);
  }
  @media (max-width: 719px) {
    .stats li:nth-child(3) {
      border-left: none;
    }
    .stats li:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }
  .value {
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    font-weight: 500;
    color: var(--accent);
    letter-spacing: -0.02em;
  }
  .label {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.4;
  }
</style>
