---
import type { Content, Lang } from '../data/types';
import { profile } from '../data/profile';
import { publicFileExists, withBase } from '../lib/utils';
import Icon from './Icon.astro';

interface Props {
  t: Content;
  lang: Lang;
}
const { t, lang } = Astro.props;
const hasPhoto = publicFileExists(profile.photo);
const cvFile = profile.cvPdf[lang];
const hasCv = publicFileExists(cvFile);
const term = t.hero.terminal;
---

<section id="top" class="hero">
  <div class="container grid">
    <div class="intro">
      <div class="avatar" aria-hidden={!hasPhoto}>
        {hasPhoto ? <img src={withBase(profile.photo)} alt={profile.name} width="88" height="88" /> : <span class="mono">{profile.initials}</span>}
      </div>
      <p class="kicker mono"><span class="accent">$</span> {t.hero.kicker}</p>
      <h1>{profile.name}</h1>
      <p class="role">{t.hero.role}</p>
      <p class="tagline">{t.hero.tagline}</p>
      <div class="hero-actions">
        <a href="#projects" class="btn btn-primary">{t.ui.seeProjects} <Icon name="arrow" /></a>
        {hasCv && <a href={withBase(cvFile)} class="btn" download><Icon name="download" /> {t.ui.downloadCv}</a>}
        <div class="socials">
          <a href={profile.linkedin} class="social" aria-label="LinkedIn" target="_blank" rel="noopener"><Icon name="linkedin" /></a>
          {profile.github && <a href={profile.github} class="social" aria-label="GitHub" target="_blank" rel="noopener"><Icon name="github" /></a>}
          <a href={`mailto:${profile.email}`} class="social" aria-label="E-mail"><Icon name="mail" /></a>
        </div>
      </div>
    </div>

    <div class="terminal card mono" aria-hidden="true">
      <div class="term-bar">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="term-title">~/augusto — zsh</span>
      </div>
      <pre class="term-body"><span class="accent">$</span> cat {term.file}
{'{'}
  <span class="k">"name"</span>: <span class="s">"{profile.shortName}"</span>,
  <span class="k">"role"</span>: <span class="s">"{term.role}"</span>,
  <span class="k">"focus"</span>: [{term.focus.map((f, i) => <><span class="s">"{f}"</span>{i < term.focus.length - 1 ? ', ' : ''}</>)}],
  <span class="k">"location"</span>: <span class="s">"{term.location}"</span>,
  <span class="k">"status"</span>: <span class="ok">"● {term.status}"</span>
{'}'}
<span class="accent">$</span> <span class="cursor"></span></pre>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 72px 0 88px;
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: -1px -1px;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 120px;
    background: linear-gradient(transparent, var(--bg));
    pointer-events: none;
  }
  .grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: 1.15fr 1fr;
      gap: 56px;
    }
  }
  .avatar {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--accent-soft);
    border: 2px solid var(--accent);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 500;
    margin-bottom: 24px;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .kicker {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 8px;
  }
  .accent {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.035em;
  }
  .role {
    margin-top: 10px;
    font-size: clamp(1.1rem, 2.4vw, 1.35rem);
    font-weight: 600;
    color: var(--accent);
  }
  .tagline {
    margin-top: 18px;
    max-width: 56ch;
    color: var(--muted);
    font-size: 1.05rem;
  }
  .hero-actions {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .socials {
    display: flex;
    gap: 6px;
  }
  .social {
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    color: var(--muted);
    border: 1px solid transparent;
  }
  .social:hover {
    color: var(--accent);
    border-color: var(--border);
    background: var(--surface);
  }

  .terminal {
    overflow: hidden;
    min-width: 0;
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }
  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ff5f57;
  }
  .dot:nth-child(2) {
    background: #febc2e;
  }
  .dot:nth-child(3) {
    background: #28c840;
  }
  .term-title {
    margin-left: 10px;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .term-body {
    margin: 0;
    padding: 20px 20px 22px;
    font-size: 0.84rem;
    line-height: 1.75;
    color: var(--text);
    white-space: pre-wrap;
    word-break: break-word;
  }
  .k {
    color: var(--code-key);
  }
  .s {
    color: var(--code-str);
  }
  .ok {
    color: var(--ok);
  }
  .cursor {
    display: inline-block;
    width: 8px;
    height: 1.05em;
    vertical-align: text-bottom;
    background: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cursor {
      animation: blink 1.1s steps(1) infinite;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
