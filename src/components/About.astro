---
import type { Content } from '../data/types';
import { profile } from '../data/profile';
import SectionHead from './SectionHead.astro';

interface Props {
  t: Content;
}
const { t } = Astro.props;
const term = t.hero.terminal;
---

<section id="about" class="section">
  <div class="container">
    <SectionHead num="01" title={t.about.title} />
    <div class="grid reveal">
      <div class="text">
        {t.about.paragraphs.map((p) => <p set:html={p} />)}
      </div>

      <div class="terminal card mono" aria-hidden="true">
        <div class="term-bar">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span class="term-title">~/augusto — zsh</span>
        </div>
        <pre class="term-body"><span class="accent">$</span> cat {term.file}
{'{'}
  <span class="k">"name"</span>: <span class="s">"{profile.shortName}"</span>,
  <span class="k">"role"</span>: <span class="s">"{term.role}"</span>,
  <span class="k">"focus"</span>: [
{term.focus.map((f, i) => <>    <span class="s">"{f}"</span>{i < term.focus.length - 1 ? ',' : ''}
</>)}  ]
{'}'}
<span class="accent">$</span> <span class="cursor"></span></pre>
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 36px;
    align-items: start;
  }
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: 1.15fr 1fr;
      gap: 56px;
    }
  }
  .text {
    display: grid;
    gap: 16px;
    color: var(--muted);
    font-size: 1.05rem;
    max-width: 65ch;
  }

  .terminal {
    overflow: hidden;
    min-width: 0;
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 11px 14px;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }
  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ff5f57;
  }
  .dot:nth-child(2) {
    background: #febc2e;
  }
  .dot:nth-child(3) {
    background: #28c840;
  }
  .term-title {
    margin-left: 10px;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .term-body {
    margin: 0;
    padding: 18px 20px 20px;
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--text);
    white-space: pre-wrap;
    word-break: break-word;
  }
  .accent {
    color: var(--accent);
  }
  .k {
    color: var(--code-key);
  }
  .s {
    color: var(--code-str);
  }
  .cursor {
    display: inline-block;
    width: 8px;
    height: 1.05em;
    vertical-align: text-bottom;
    background: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cursor {
      animation: blink 1.1s steps(1) infinite;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
